{
  "name": "asset-manage",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "build": "mc-scripts build",
    "start": "mc-scripts start",
    "login": "mc-scripts login",
    "sync": "mc-scripts config:sync",
    "compile-html": "mc-scripts compile-html",
    "compile-html:local": "MC_APP_ENV=development mc-scripts compile-html --transformer @commercetools-frontend/mc-dev-authentication/transformer-local.js",
    "start:prod:local": "npm run compile-html:local && mc-scripts serve",
    "extract-intl": "formatjs extract --format=./intl-formatter.js --out-file=./src/i18n/data/core.json 'src/**/!(*.spec).(ts|tsx)'",
    "test": "jest --config jest.test.config.js",
    "test:watch": "jest --config jest.test.config.js --watch",
    "lint": "eslint .",
    "format": "prettier --write '**/*.{js,ts,tsx}'",
    "typecheck": "tsc --noEmit",
    "versions:appkit": "manypkg upgrade @commercetools-frontend",
    "generate-types:chakra": "node -r ./scripts/chakra-typegen-dom-shim.cjs ./node_modules/.bin/chakra typegen node_modules/@commercetools/nimbus/dist/index.es.js",
    "generate-types:ctp": "node ./scripts/login.js && graphql-codegen -r ./scripts/load-env.js --config codegen.ctp.yml",
    "postinstall": "npm run generate-types:chakra"
  },
  "dependencies": {
    "@apollo/client": "3.12.4",
    "@babel/core": "^7.22.17",
    "@babel/runtime-corejs3": "^7.22.15",
    "@chakra-ui/react": "^3.36.1",
    "@commercetools-demo/puck-image-picker": "^0.8.1",
    "@commercetools-frontend/actions-global": "^27.12.0",
    "@commercetools-frontend/application-components": "^27.12.0",
    "@commercetools-frontend/application-config": "^27.12.0",
    "@commercetools-frontend/application-shell": "^27.12.0",
    "@commercetools-frontend/application-shell-connectors": "^27.12.0",
    "@commercetools-frontend/assets": "^27.12.0",
    "@commercetools-frontend/babel-preset-mc-app": "^27.12.0",
    "@commercetools-frontend/constants": "^27.12.0",
    "@commercetools-frontend/eslint-config-mc-app": "^27.12.0",
    "@commercetools-frontend/i18n": "^27.12.0",
    "@commercetools-frontend/jest-preset-mc-app": "^27.12.0",
    "@commercetools-frontend/l10n": "^27.12.0",
    "@commercetools-frontend/mc-dev-authentication": "^27.12.0",
    "@commercetools-frontend/mc-scripts": "^27.12.0",
    "@commercetools-frontend/permissions": "^27.12.0",
    "@commercetools/nimbus": "3.4.0",
    "@commercetools/nimbus-icons": "^3.4.0",
    "@commercetools/nimbus-tokens": "^3.4.0",
    "@commercetools/sync-actions": "^8.4.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@formatjs/cli": "6.16.18",
    "@graphql-codegen/add": "^5.0.0",
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/introspection": "^4.0.0",
    "@graphql-codegen/typescript": "^4.0.1",
    "@graphql-codegen/typescript-graphql-files-modules": "^3.0.0",
    "@graphql-codegen/typescript-operations": "^4.0.1",
    "@graphql-eslint/eslint-plugin": "^4.4.1",
    "@jest/types": "29.6.3",
    "@manypkg/cli": "0.25.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/react-hooks": "8.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.2.4",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "eslint": "^9.0.0",
    "eslint-formatter-pretty": "4.1.0",
    "formik": "2.4.9",
    "graphql": "16.14.2",
    "graphql-tag": "^2.12.6",
    "jest": "30.4.2",
    "jest-watch-typeahead": "^3.0.0",
    "moment": "^2.29.4",
    "msw": "^1.3.5",
    "omit-empty-es": "1.2.0",
    "prettier": "2.8.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intl": "^7.1.4",
    "react-redux": "9.3.0",
    "react-router-dom": "5.3.4",
    "redux": "5.0.1",
    "slate": "^0.123.0",
    "slate-dom": "^0.124.1",
    "slate-history": "^0.115.0",
    "slate-hyperscript": "^0.115.0",
    "slate-react": "^0.123.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@apollo/client": "$@apollo/client",
    "react": "$react",
    "react-dom": "$react-dom",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@types/react-router": "$@types/react-router",
    "@types/react-router-dom": "$@types/react-router-dom",
    "headers-polyfill": "3.2.5",
    "nwsapi": "2.2.7"
  },
  "packageManager": "npm@10.9.2"
}
